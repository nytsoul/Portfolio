# ================================
# CONVEX BACKEND CONFIGURATION
# ================================
# Get these values by running 'npx convex dev'
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=http://localhost:3000
CONVEX_DEPLOYMENT=dev:your-deployment

# ================================
# VLY PLATFORM (Pre-configured)
# ================================
NEXT_PUBLIC_VLY_APP_ID="your-vly-app-id"
NEXT_PUBLIC_VLY_MONITORING_URL="https://runtime-monitoring.vly.ai/runtime-error"

# ================================
# GITHUB INTEGRATION
# ================================
# Your GitHub username for fetching repositories
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# GitHub Personal Access Token (server-side only, not exposed to client)
# Generate at: https://github.com/settings/tokens
# Permissions needed: repo (read-only)
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE

# ================================
# PORTFOLIO CONFIGURATION
# ================================
NEXT_PUBLIC_PORTFOLIO_NAME="Your Full Name"
NEXT_PUBLIC_PORTFOLIO_LOCATION="Your City, Country"
NEXT_PUBLIC_PORTFOLIO_EMAIL=your.email@example.com
NEXT_PUBLIC_PORTFOLIO_WEBSITE=https://yourwebsite.com
NEXT_PUBLIC_PORTFOLIO_LINKEDIN=https://linkedin.com/in/your-profile
NEXT_PUBLIC_PORTFOLIO_GITHUB=your-github-username
NEXT_PUBLIC_PORTFOLIO_TAGLINE="Your professional tagline or headline"
NEXT_PUBLIC_PORTFOLIO_BIO="Brief bio about yourself, your background, and what you do."

# ================================
# ACADEMIC & PROFESSIONAL INFO
# ================================
NEXT_PUBLIC_COLLEGE_NAME="Your University Name"
NEXT_PUBLIC_COLLEGE_LOCATION="City"
NEXT_PUBLIC_DEGREE="Your Degree Program"
NEXT_PUBLIC_YEAR="Current Year (e.g., 2nd Year, Final Year)"
NEXT_PUBLIC_GPA="Your GPA"
NEXT_PUBLIC_EXPERIENCE_YEARS="Years of experience (e.g., 1+, 2+)"

# ================================
# COMPETITIVE PROGRAMMING
# ================================
NEXT_PUBLIC_CODEFORCES_USERNAME=your-codeforces-username
NEXT_PUBLIC_CODEFORCES_PROBLEMS_SOLVED=0
NEXT_PUBLIC_LEETCODE_USERNAME=your-leetcode-username
NEXT_PUBLIC_CODECHEF_USERNAME=your-codechef-username

# ================================
# PROJECTS & ACHIEVEMENTS
# ================================
NEXT_PUBLIC_PROJECTS_COMPLETED=0
NEXT_PUBLIC_TOTAL_CONTRIBUTIONS=0

# ================================
# FEATURE FLAGS
# ================================
NEXT_PUBLIC_ENABLE_GITHUB_SYNC=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_TYPEWRITER=true
NEXT_PUBLIC_ENABLE_ANIMATIONS=true

# ================================
# ANALYTICS (Optional)
# ================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_POSTHOG_KEY=

# ================================
# CONTACT FORM SERVICES (Optional)
# ================================
# Formspree: https://formspree.io/
NEXT_PUBLIC_FORMSPREE_ID=

# EmailJS: https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ================================
# SEO & METADATA
# ================================
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_TITLE="Your Name - Portfolio"
NEXT_PUBLIC_SITE_DESCRIPTION="Brief description for search engines and social media."
NEXT_PUBLIC_SITE_KEYWORDS="portfolio,developer,your,keywords,here"
NEXT_PUBLIC_SITE_AUTHOR="Your Name"
NEXT_PUBLIC_SITE_IMAGE=/og-image.jpg

# ================================
# SOCIAL MEDIA (Optional)
# ================================
NEXT_PUBLIC_TWITTER_HANDLE=@your_twitter
NEXT_PUBLIC_FACEBOOK_PAGE=
NEXT_PUBLIC_INSTAGRAM_HANDLE=@your_instagram
NEXT_PUBLIC_YOUTUBE_CHANNEL=
NEXT_PUBLIC_MEDIUM_USERNAME=@your_medium
NEXT_PUBLIC_DEV_TO_USERNAME=your_devto

# ================================
# RESUME/CV
# ================================
NEXT_PUBLIC_RESUME_URL=/resume.pdf
NEXT_PUBLIC_CV_LAST_UPDATED=2024-01-15

# ================================
# GITHUB API CONFIGURATION
# ================================
NEXT_PUBLIC_GITHUB_API_BASE=https://api.github.com
NEXT_PUBLIC_GITHUB_CACHE_DURATION=3600000
NEXT_PUBLIC_GITHUB_MAX_REPOS=100

# ================================
# DEVELOPMENT
# ================================
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_BUILD_DATE=
NEXT_PUBLIC_DEBUG_MODE=false

# ================================
# PERFORMANCE
# ================================
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
NEXT_PUBLIC_CACHE_IMAGES=true
NEXT_PUBLIC_LAZY_LOAD_IMAGES=true

# ================================
# THEME CONFIGURATION
# ================================
NEXT_PUBLIC_DEFAULT_THEME=dark
NEXT_PUBLIC_ENABLE_THEME_TOGGLE=false
NEXT_PUBLIC_PRIMARY_COLOR=#06b6d4
NEXT_PUBLIC_ACCENT_COLOR=#8b5cf6
